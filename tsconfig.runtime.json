{
  // Runtime-only resolution config for `bun src/index.ts` in production
  // (Dockerfile CMD passes --tsconfig-override). Only `@/*` is needed
  // now — the legacy `@/llms/*` stub indirection went away with the
  // vendor/llms removal.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  }
}
