{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "workspaces": {
    ".": {
      // src/components/ui/** is shadcn-owned surface, regenerated by
      // `bunx shadcn@latest add <component> --overwrite` (see CLAUDE.md).
      // Listed as entry rather than ignored so the vendored components
      // that nothing imports yet are not reported as dead files, while
      // the dependencies they pull in (recharts, react-hook-form,
      // react-colorful, @radix-ui/react-slot, cmdk, …) still count as
      // used. Keeping them vendored means a future `shadcn add` does not
      // have to re-vendor them.
      "entry": [
        "src/index.ts",
        "src/components/ui/**/*.tsx",
        "scripts/**/*.ts",
        "__tests__/**/*.ts"
      ],
      "project": ["src/**/*.{ts,tsx}", "scripts/**/*.ts", "__tests__/**/*.ts"]
    }
  },
  // Dependencies knip cannot see an import for. Most are reached from
  // src/index.css, which knip skips (see the ".css compiled extension"
  // hint); the @radix-ui/react-* set is pulled in through the `radix-ui`
  // umbrella re-export rather than by name; the rest are resolved at
  // runtime or by tooling.
  "ignoreDependencies": [
    "tw-animate-css",
    "tailwindcss-animate",
    "@fontsource-variable/geist-mono",
    "@fontsource-variable/inter",
    "tailwindcss",
    "shadcn",
    "@anthropic-ai/sdk",
    "@google/genai",
    "@openai/codex",
    "fastify",
    "fastify-plugin",
    "@fastify/cors",
    "google-auth-library",
    "jsonrepair",
    "@prisma/client",
    "@radix-ui/react-accordion",
    "@radix-ui/react-checkbox",
    "@radix-ui/react-collapsible",
    "@radix-ui/react-dialog",
    "@radix-ui/react-label",
    "@radix-ui/react-popover",
    "@radix-ui/react-select",
    "@radix-ui/react-separator",
    "@radix-ui/react-switch",
    "@radix-ui/react-tabs",
    "@radix-ui/react-tooltip"
  ],
  "ignoreExportsUsedInFile": true
}
