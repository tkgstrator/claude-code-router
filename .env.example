# Copy to .env and fill in. The .env file is gitignored.
#
# Provider keys (used by tests and the local config you import into the DB).
GEMINI_API_KEY=
OPENAI_API_KEY=

# Postgres connection used by the server to load Providers / Router / etc.
# The DB is brought up by .devcontainer/compose.yaml — `postgres` resolves
# inside the devcontainer's docker network. host.docker.internal:5432 works
# too if you prefer the host-facing name.
DATABASE_URL=postgres://postgres:password@postgres:5432/ccr

# Redis (BullMQ) for the recurring usage-capture job. Brought up by
# .devcontainer/compose.yaml — `redis` resolves on the devcontainer
# network. The server still serves if Redis is down; usage history
# just won't update until it's reachable.
REDIS_URL=redis://redis:6379

# Required: encryption key for SubAccount token-at-rest.
# 32-byte base64 or 64-char hex recommended.
CCR_ACCOUNT_ENCRYPTION_KEY=

# Optional: subscription credential directories (preferred).
# The server reads every *.json in these directories.
CCR_CLAUDE_CREDENTIALS_DIR=/home/vscode/app/ccr-auth
CCR_CODEX_AUTH_DIR=/home/vscode/app/ccr-auth

# Optional: explicit credential files (comma-separated, fallback when DIR is unset/empty).
# If unset, defaults are used:
#   Claude: ~/.claude/.credentials.json
#   Codex:  ~/.codex/auth.json
CCR_CLAUDE_CREDENTIALS_FILES=/home/vscode/app/ccr-auth/claude-credentials.json
CCR_CODEX_AUTH_FILES=/home/vscode/app/ccr-auth/codex-auth.json
