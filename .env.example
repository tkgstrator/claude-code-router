# Copy to .env and fill in. The .env file is gitignored.
#
# Provider keys (used by tests and the local config you import into the DB).
GEMINI_API_KEY=
OPENAI_API_KEY=

# Postgres connection used by the server to load Providers / Router / etc.
# The DB is brought up by .devcontainer/compose.yaml — `postgres` resolves
# inside the devcontainer's docker network. host.docker.internal:5432 works
# too if you prefer the host-facing name.
DATABASE_URL=postgres://postgres:password@postgres:5432/ccr
