{
  "$schema": "https://biomejs.dev/schemas/2.4.14/schema.json",
  "plugins": [
    "./biome-plugins/no-nullish-coalescing.grit",
    "./biome-plugins/no-type-assertion.grit",
    "./biome-plugins/prefer-z-uuid.grit",
    "./biome-plugins/prefer-z-url.grit",
    "./biome-plugins/prefer-z-nonempty.grit",
    "./biome-plugins/no-bare-z-string.grit"
  ],
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "files": {
    "includes": [
      "packages/shared/src/**/*.{ts,tsx}",
      "packages/cli/src/**/*.{ts,tsx}",
      "!**/node_modules",
      "!**/dist"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {},
      "a11y": {},
      "style": {
        "useImportType": "error",
        "noParameterAssign": "error",
        "noRestrictedGlobals": {
          "level": "warn",
          "options": {
            "deniedGlobals": {
              "Date": "Use dayjs() instead",
              "globalThis": "Avoid globalThis; pass dependencies explicitly"
            }
          }
        }
      },
      "suspicious": {
        "noConsole": {
          "level": "warn",
          "options": { "allow": ["error", "warn"] }
        }
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": "warn"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "includes": ["**"],
    "attributePosition": "auto",
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 80
  },
  "javascript": {
    "formatter": {
      "enabled": true,
      "arrowParentheses": "always",
      "bracketSameLine": false,
      "bracketSpacing": true,
      "jsxQuoteStyle": "single",
      "quoteStyle": "single",
      "quoteProperties": "asNeeded",
      "semicolons": "asNeeded",
      "indentStyle": "space",
      "indentWidth": 2,
      "lineWidth": 120,
      "trailingCommas": "none"
    }
  },
  "json": {
    "formatter": {
      "trailingCommas": "none"
    }
  }
}
