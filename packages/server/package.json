{
  "name": "@ccr/server",
  "version": "2.0.0",
  "description": "Server for Claude Code Router",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./config": {
      "bun": "./src/services/configService.ts",
      "import": "./src/services/configService.ts"
    },
    "./subscriptions": {
      "bun": "./src/services/subscriptionInfoService.ts",
      "import": "./src/services/subscriptionInfoService.ts"
    },
    "./update": {
      "bun": "./src/utils/update.ts",
      "import": "./src/utils/update.ts"
    },
    "./models": {
      "bun": "./src/services/modelSyncService.ts",
      "import": "./src/services/modelSyncService.ts"
    },
    "./providers": {
      "bun": "./src/services/providerTestService.ts",
      "import": "./src/services/providerTestService.ts"
    },
    "./package": {
      "import": "./package.json"
    }
  },
  "scripts": {
    "build": "bun run ../../scripts/build-server.ts",
    "dev": "bun --watch run src/index.ts",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio"
  },
  "keywords": [
    "claude",
    "code",
    "router",
    "server"
  ],
  "author": "musistudio",
  "license": "MIT",
  "dependencies": {
    "@fastify/multipart": "^9.0.0",
    "@fastify/static": "^8.2.0",
    "@musistudio/llms": "workspace:*",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7",
    "adm-zip": "^0.5.16",
    "dotenv": "^16.4.7",
    "json5": "^2.2.3",
    "lru-cache": "^11.2.2",
    "pg": "^8.20.0",
    "rotating-file-stream": "^3.2.7",
    "shell-quote": "^1.8.3",
    "tiktoken": "^1.0.21",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@ccr/shared": "workspace:*",
    "@types/adm-zip": "^0.5.7",
    "@types/bun": "^1.2.0",
    "@types/pg": "^8.20.0",
    "fastify": "^5.4.0",
    "prisma": "^7",
    "typescript": "^5.8.2"
  }
}
