node_modules
.env
.env.*
!.env.example
log.txt
.idea
dist
coverage
.DS_Store
tsconfig.tsbuildinfo
tsconfig.*.tsbuildinfo

# Documentation build output
docs/build
docs/.docusaurus

# Package manager caches
.pnpm-store/

# Prisma client is generated locally via `bun run db:generate`
src/generated

# tsc emits next to the .ts source when scripts/tsconfig is invoked directly
scripts/*.js
scripts/*.js.map
scripts/*.d.ts

# Personal Claude Code overrides — settings.local.json lives outside the team
# settings.json so individual permission tweaks stay out of git.
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/worktrees/

# Python bytecode cache
__pycache__/

# mitmproxy capture output (sessions + JSON pairs)
captures/

# Local self-host runtime state: compose.yaml bind-mounts the config
# envelope here, including the minted APIKEY, rotating backups and logs.
# Never commit it (already excluded from the image via .dockerignore).
ccr-config/

# Local subscription credential mirrors fed to the dev server. Both
# directories hold OAuth tokens / IDE configs and must never be committed.
ccr-auth/
.codex/

# Artifacts dropped at the repo root by browser MCP tools (Playwright /
# chrome-devtools save into the cwd). Never commit these.
/*.png
.playwright-mcp/
screenshots/
logs/
