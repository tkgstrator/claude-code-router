{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["bun", "node", "react", "react-dom", "vite/client"],
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      // More specific than @/* — routes the vendored llms imports to
      // an `any` stub for typecheck only (Vite + tsconfig.runtime.json
      // resolve the real source at runtime). Keeps llms' loose types
      // out of `tsc`.
      "@/llms/*": ["./src/vendor/llms-vendor.ts"],
      "@/*": ["./src/*"]
    },
    "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "scripts/**/*.ts", "vite.config.ts"],
  // src/vendor/llms is the absorbed @musistudio/llms vendor subsystem.
  // Built via esbuild bundling (never tsc-typechecked) and carries its
  // own latent loose typings; keep it out of the strict root typecheck
  // so `tsc --noEmit` stays meaningful for our code. src/generated is
  // machine-generated.
  "exclude": ["node_modules", "dist", "src/vendor/llms", "src/generated"]
}
