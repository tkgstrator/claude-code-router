{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["bun", "node", "react", "react-dom", "vite/client"],
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "scripts/**/*.ts", "vite.config.ts"],
  // src/llms is the absorbed @musistudio/llms vendor subsystem. It was
  // always built via esbuild bundling (never tsc-typechecked) and
  // carries its own latent loose typings; keep it out of the strict
  // root typecheck so `tsc --noEmit` stays meaningful for our code.
  // src/generated/prisma is machine-generated.
  "exclude": ["node_modules", "dist", "src/llms", "src/generated"]
}
