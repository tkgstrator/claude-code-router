event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"ですね。両方とも脱獄シーンでよ"}               }

event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"く使われるツールです。\n\n## Theos\n\n**長年の標準ツール。**"}      }

event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":" クロスプラットフォームのビルドシステムで、Logos（Objective-C"}            }

event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"拡張）を使ったTweak開発の事実上のスタンダードです。\n\n**"}             }

event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"良い点：**\n- 成熟していて情報が豊富\n- ほぼす"}            }

event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"べての既存Tweakがこれで作られ"}   }

event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"ている\n- `nic.pl` でテ"}       }

event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"ンプレートから素早く開始できる"}          }

event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"\n\n**気になる点：**\n- Objective-C/Logos構文が現代的"}    }

event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"ではない\n- Swift対応が後付け感ある\n\n## Orion\n\n**Swi"}}

event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"ftネイティブで書ける現代的な"} }

event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"フレームワーク。** Theosと併用する形で動き"}       }

event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"ます（Theosのビルドシステム上で動作）。\n\n**良い点：**\n- Swiftで`"}        }

event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"@Hook`などの宣言的構文が使える\n- 型"}     }

event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"安全\n- iOS開発者にとって馴染みやすい\n\n**気になる"}    }

event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"点：**\n- Logosほど成熟していない\n- 古典的な"}     }

event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"Tweak開発の知識（Logos）が依然として"}       }

event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"必要\n- Swift ABIの問題で多少注意が必要\n\n## 個人的な"}              }

event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"見解\n\n**新規プロジェクトならOrion"}           }

event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"** がおすすめです。Swiftで書ける利点は大きく、可読性・"}             }

event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"保守性ともに改善されます。ただし、**既存のTweakを参考にする場"}           }

event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"合や、ローレベルなフックが必要な場合はLog"}      }

event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"os/Theosの知識が必須** なので、両方理解しておくのが理想"}     }

event: content_block_delta
data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"です。\n\n何か具体的に作りたいTweakがありますか？"}            }

