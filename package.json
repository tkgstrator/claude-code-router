{
  "name": "@musistudio/claude-code-router",
  "version": "2.0.2",
  "description": "Use Claude Code without an Anthropics account and route it to another LLM provider",
  "scripts": {
    "dev": "vite --host --port 16175",
    "build": "vite build",
    "release": "bun run build && bash scripts/release.sh docker",
    "release:docker": "bash scripts/release.sh docker",
    "dev:ui": "vite",
    "test": "bun test __tests__/lib __tests__/db __tests__/preset",
    "test:coverage": "bun test --coverage __tests__/lib __tests__/db __tests__/preset",
    "test:providers": "bun test __tests__/providers",
    "db:migrate:test": "TEST_DATABASE_URL=\"${TEST_DATABASE_URL:-postgres://postgres:password@postgres:5432/ccr_test}\" DATABASE_URL=\"$TEST_DATABASE_URL\" prisma migrate deploy",
    "scrape:openai-prices": "bun run scripts/scrape-openai-prices.ts",
    "scrape:anthropic-prices": "bun run scripts/scrape-anthropic-prices.ts",
    "scrape:google-prices": "bun run scripts/scrape-gemini-pricing.ts",
    "scrape:prices": "bun run scripts/scrape-all-prices.ts",
    "seed:prices-db": "bun run scripts/seed-prices-db.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate && git config core.hooksPath .githooks || true",
    "knip": "knip"
  },
  "keywords": [
    "claude",
    "code",
    "router",
    "llm",
    "anthropic"
  ],
  "author": "musistudio",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@openai/codex": "^0.139.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.0",
    "knip": "^6.16.1",
    "playwright": "^1.60.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "overrides": {
    "@types/react": "18",
    "ioredis": "5.10.1"
  },
