{
  "name": "@musistudio/claude-code-router",
  "version": "2.0.0",
  "description": "Use Claude Code without an Anthropics account and route it to another LLM provider",
  "scripts": {
    "dev": "vite --host --port 16173",
    "build": "bun run build:shared && bun run build:core && bun run build:server && bun run build:ui && bun run build:cli",
    "build:core": "bun run --filter @musistudio/llms build",
    "build:shared": "bun run --filter @ccr/shared build",
    "build:cli": "bun run --filter @ccr/cli build",
    "build:server": "bun run --filter @ccr/server build",
    "build:ui": "vite build",
    "build:docs": "bun run --filter claude-code-router-docs build",
    "release": "bun run build && bash scripts/release.sh all",
    "release:npm": "bash scripts/release.sh npm",
    "release:docker": "bash scripts/release.sh docker",
    "dev:cli": "bun run --filter @ccr/cli dev",
    "dev:server": "bun run --filter @ccr/server dev",
    "dev:ui": "vite",
    "dev:core": "bun run --filter @musistudio/llms dev",
    "dev:docs": "bun run --filter claude-code-router-docs start",
    "serve:docs": "bun run --filter claude-code-router-docs serve",
    "test:providers": "bun test __tests__/providers"
  },
  "bin": {
    "ccr": "dist/cli.js"
  },
  "keywords": [
    "claude",
    "code",
    "router",
    "llm",
    "anthropic"
  ],
  "author": "musistudio",
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/bun": "^1.2.0",
    "@types/node": "^25.8.0",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.8.2",
    "vite": "^8.0.13",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "overrides": {
    "@types/react": "18"
  },
  "workspaces": [
    "packages/*",
    "docs"
  ],
  "dependencies": {
    "@ccr/server": "workspace:*",
    "@ccr/shared": "workspace:*",
    "@hono/vite-dev-server": "^0.25.3",
    "@hono/zod-openapi": "^1.4.0",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dotenv": "^17.4.2",
    "hono": "^4.12.18",
    "i18next": "^26.2.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.16.0",
    "react": "19",
    "react-colorful": "^5.7.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "19",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^7.15.1",
    "remixicon": "^4.9.1",
    "simple-icons": "^16.19.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.4.3"
  }
}
